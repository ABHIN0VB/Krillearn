# ── Gemini AI (required for AI-generated questions) ───────────────────────────
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# ── CORS / Origins (required in production) ───────────────────────────────────
# Set both to your Vercel frontend URL in production, e.g. https://your-app.vercel.app
# Leave as * only for local development.
FRONTEND_ORIGIN=*
SOCKET_CORS_ORIGINS=*

# ── Database (optional) ───────────────────────────────────────────────────────
# On Render, mount a persistent disk at /var/data and set DB_PATH=/var/data/quizclash.db
DB_PATH=quizclash.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0
